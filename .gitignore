# ============================================
# .gitignore para compiladores-pl3
# Proyecto ANTLR4 + Java + Maven
# ============================================

# -------------------- Java --------------------
# Compiled class files
*.class

# Log files
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files
*.jar
*.war
*.nar
*.ear
*.zip
!jasmin/**/*.zip
*.tar.gz
*.rar

# Virtual machine crash logs
hs_err_pid*
replay_pid*

# -------------------- Jasmin (download separately, see README) --------------------
jasmin/herramientas/

# -------------------- Maven --------------------
# Maven target directory
compilador/target/
compilador/.mvn/wrapper/

# Maven wrapper
.mvn/wrapper/maven-wrapper.jar
.mvn/wrapper/maven-wrapper.properties

# -------------------- ANTLR4 --------------------
# Generated ANTLR files
# Descomentar si NO se quiere versionar los archivos generados:
# compilador/gen/
# **/*Lexer.java
# **/*Parser.java
# **/*Listener.java
# **/*Visitor.java
# **/*BaseListener.java
# **/*BaseVisitor.java
# *.tokens
# *.interp

# Cache de ANTLR
**/.antlr/

# -------------------- IDE --------------------
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.classpath
.project
.settings/
bin/

# NetBeans
nbproject/
build/
nbbuild/
dist/
nbdist/

# VS Code
.vscode/
*.code-workspace

# -------------------- Sistema Operativo --------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# -------------------- Otros --------------------
# Archivos temporales
*.tmp
*.bak
*.swp
*~.nib

# Archivos de configuración local
local.properties

# -------------------- Archivos Generados --------------------
# Archivos Jasmin generados (.j) - excepto los de ejemplos
*.j
!jasmin/**/*.j

# Archivos JSON generados (salidas de pruebas)
pruebas/**/*_salida.json
