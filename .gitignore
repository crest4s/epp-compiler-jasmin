# ============================================
# .gitignore para compiladores-pl3
# Proyecto ANTLR4 + Java + Maven
# ============================================

# -------------------- Java --------------------
# Compiled class files
*.class

# Log files
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files
*.jar
!Jasmin/**/jasmin.jar
*.war
*.nar
*.ear
*.zip
!Jasmin/**/*.zip
*.tar.gz
*.rar

# Virtual machine crash logs
hs_err_pid*
replay_pid*

# -------------------- Maven --------------------
# Maven target directory (solo en maven-project)
maven-project/target/
maven-project/.mvn/wrapper/

# Maven wrapper
.mvn/wrapper/maven-wrapper.jar
.mvn/wrapper/maven-wrapper.properties

# -------------------- ANTLR4 --------------------
# Generated ANTLR files (mantener gen/ si se quiere versionar)
# Descomentar si NO se quiere versionar los archivos generados:
# maven-project/gen/
# **/*Lexer.java
# **/*Parser.java
# **/*Listener.java
# **/*Visitor.java
# **/*BaseListener.java
# **/*BaseVisitor.java
# *.tokens
# *.interp

# -------------------- IDE --------------------
# IntelliJ IDEA (solo en maven-project)
maven-project/.idea/
maven-project/*.iml
maven-project/*.iws
maven-project/*.ipr
maven-project/out/

# Eclipse
.classpath
.project
.settings/
bin/

# NetBeans
nbproject/
build/
nbbuild/
dist/
nbdist/

# VS Code
.vscode/
*.code-workspace

# -------------------- Sistema Operativo --------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# -------------------- Otros --------------------
# Archivos temporales
*.tmp
*.bak
*.swp
*~.nib

# Archivos de configuración local
local.properties
