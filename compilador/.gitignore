!**/src/main/**/target/
!**/src/test/**/target/
.mvn/wrapper/maven-wrapper.jar
.mvn/wrapper/maven-wrapper.properties

# -------------------- Kotlin --------------------
.kotlin

# -------------------- IntelliJ IDEA --------------------
.idea/modules.xml
.idea/jarRepositories.xml
.idea/compiler.xml
.idea/libraries/
.idea/workspace.xml
.idea/shelf/
.idea/httpRequests/
*.iws
*.iml
*.ipr

# -------------------- Eclipse --------------------
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# -------------------- NetBeans --------------------
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# -------------------- VS Code --------------------
.vscode/

# -------------------- Sistema Operativo --------------------
# macOS
.DS_Store

# Windows
Thumbs.db

